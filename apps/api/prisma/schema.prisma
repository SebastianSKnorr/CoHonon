generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_PUBLIC_URL")
}

// ── User ─────────────────────────────────────────────────────────────────────

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  name        String    // display name / username
  firstName   String?
  lastName    String?
  phone       String?   // E.164 format: +4712345678
  language    String?   // BCP-47: "nb", "en", "de"
  timezone    String?   // IANA: "Europe/Oslo"
  avatarUrl   String?
  bio         String?
  dateOfBirth DateTime?
  consentAI   Boolean   @default(false) // gates INFERRED observations (GDPR)
  character   Json?     // avatar appearance, world preferences
  role        Role      @default(USER)
  balance     Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  addresses    Address[]
  orders       Order[]
  stores       Store[]
  entities     UserEntity[]
  observations UserObservation[]
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?  // "Home", "Work", "Warehouse"
  firstName  String
  lastName   String
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String   // ISO 3166-1 alpha-2: "NO", "US", "GB"
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ── Knowledge Graph ───────────────────────────────────────────────────────────

model UserEntity {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        EntityType
  name        String
  description String?
  metadata    Json       @default("{}")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  outgoing     UserRelation[]    @relation("RelationSource")
  incoming     UserRelation[]    @relation("RelationTarget")
  observations UserObservation[]

  @@unique([userId, type, name])
  @@index([userId])
  @@index([type])
}

model UserRelation {
  id             String       @id @default(cuid())
  sourceEntityId String
  sourceEntity   UserEntity   @relation("RelationSource", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntityId String
  targetEntity   UserEntity   @relation("RelationTarget", fields: [targetEntityId], references: [id], onDelete: Cascade)
  type           RelationType
  strength       Float        @default(1.0) // 0.0–1.0 confidence
  context        String?      // why this relation exists
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([sourceEntityId, targetEntityId, type])
  @@index([sourceEntityId])
  @@index([targetEntityId])
}

model UserObservation {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityId   String?
  entity     UserEntity?       @relation(fields: [entityId], references: [id], onDelete: SetNull)
  type       ObservationType
  content    String            // e.g. "user visited Blacksmith store twice"
  confidence Float             @default(1.0) // 0.0–1.0
  source     ObservationSource
  expiresAt  DateTime?
  metadata   Json              @default("{}")
  createdAt  DateTime          @default(now())

  @@index([userId])
  @@index([entityId])
  @@index([type])
  @@index([createdAt])
}

// ── Subscribers ───────────────────────────────────────────────────────────────

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String   @default("landing") // where they signed up from
  createdAt DateTime @default(now())
}

// ── Worlds & Commerce ─────────────────────────────────────────────────────────

model World {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  theme     String
  published Boolean    @default(false)
  createdAt DateTime   @default(now())

  locations Location[]
}

model Location {
  id        String   @id @default(cuid())
  worldId   String
  world     World    @relation(fields: [worldId], references: [id])
  name      String
  x         Float
  z         Float
  tier      String   @default("standard")
  store     Store?
  createdAt DateTime @default(now())
}

model Store {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id])
  locationId  String?   @unique
  location    Location? @relation(fields: [locationId], references: [id])
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  name        String
  description String?
  price       Float
  inventory   Int      @default(0)
  images      String[]
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  status    OrderStatus @default(PENDING)
  total     Float
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  items    OrderItem[]
  shipment Shipment?
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model Shipment {
  id           String    @id @default(cuid())
  orderId      String    @unique
  order        Order     @relation(fields: [orderId], references: [id])
  carrier      String?
  tracking     String?
  dispatchedAt DateTime?
  deliveredAt  DateTime?
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum Role {
  USER
  STORE_OWNER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum EntityType {
  USER
  STORE
  PRODUCT
  CATEGORY
  PREFERENCE
  BEHAVIOR
}

enum RelationType {
  VISITED
  PURCHASED_FROM
  PREFERRED
  FOLLOWS
  SIMILAR_TO
  SEARCHED_FOR
}

enum ObservationType {
  BEHAVIOR
  PREFERENCE
  FACT
  INTERACTION
  INFERRED
}

enum ObservationSource {
  TRANSACTION
  INTERACTION
  INFERENCE
  MANUAL
}

// ── Analytics ─────────────────────────────────────────────────────────────────

model PageView {
  id        String   @id @default(cuid())
  sessionId String
  page      String
  referrer  String?
  browser   String?
  os        String?
  device    String?
  screen    String?
  language  String?
  timezone  String?
  country   String?  // from CF-IPCountry header

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
}
